{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crosswire report v2",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "tool": {
      "const": "crosswire"
    },
    "coverage": {
      "enum": [
        "complete",
        "bounded",
        "partial"
      ],
      "default": "complete",
      "description": "Optional additive field; absent in older reports, defaults to \"complete\"."
    },
    "limitations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          }
        },
        "required": [
          "count",
          "examples"
        ]
      },
      "default": {},
      "description": "Optional additive field; absent in older reports, defaults to {}."
    },
    "mode": {
      "const": "combined"
    },
    "target": {
      "type": "string"
    },
    "integrated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "branch",
          "paths"
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "max_group": {
          "type": "integer",
          "minimum": 0
        },
        "group_search_max_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "hit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "max_candidates",
        "max_group",
        "group_search_max_remaining",
        "hit"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "errors",
        "warnings"
      ]
    }
  },
  "required": [
    "version",
    "tool",
    "mode",
    "target",
    "integrated",
    "skipped",
    "findings",
    "summary",
    "limits"
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "rule": {
          "enum": [
            "CW001",
            "CW002",
            "CW003",
            "CW004",
            "CW005",
            "CW006"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional additive field; absent in older reports, defaults to null."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional additive field; absent in older reports, defaults to []."
        },
        "culprits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "culprits_exact": {
          "type": "boolean"
        },
        "resolved_by": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "location": {
          "enum": [
            "branch",
            "integrated"
          ]
        },
        "repro": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional additive field; absent in older reports, defaults to null."
        }
      },
      "required": [
        "rule",
        "severity",
        "message",
        "branch",
        "path",
        "line",
        "symbol",
        "culprits",
        "culprits_exact",
        "resolved_by",
        "location"
      ]
    }
  }
}
